# Optional. Core writing tools do not need an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=4317
# Optional overrides for the ChatGPT subscription integration.
# ChatGPT sign-in is available in The Lab; the Codex component is included.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_MODEL=your-supported-codex-model

# Optional absolute path; default is data/write-on.sqlite in the project.
# WRITE_ON_DB_PATH=/absolute/path/write-on.sqlite
